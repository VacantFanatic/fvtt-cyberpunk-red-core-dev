# Copy to ~/foundry-docker.env (recommended) or ./foundry-docker.env (gitignored).
# Cursor Cloud agents: add FOUNDRY_USERNAME and FOUNDRY_PASSWORD as repository
# secrets instead (FOUNDRY_USER / FOUNDRY_ACCOUNT_PASSWORD aliases also work).
# scripts/foundry-docker.sh materializes ~/foundry-docker.env on first startup.
#
# Get credentials from https://foundryvtt.com (account used to purchase Foundry).

FOUNDRY_USERNAME=your_foundry_account_email
FOUNDRY_PASSWORD=your_foundry_account_password

# Optional — only if you use a license key instead of username/password download:
# FOUNDRY_LICENSE_KEY=
