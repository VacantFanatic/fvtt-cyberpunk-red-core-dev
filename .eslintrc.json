{
  "extends": ["airbnb-base", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": [],
  "rules": {
    "no-warning-comments": [
      "warn",
      {
        "terms": ["TODO"]
      }
    ],
    "import/no-cycle": ["warn"],
    "import/no-unresolved": ["error", { "ignore": [".*devMode\\.js$"] }],
    "no-underscore-dangle": "off",
    "no-param-reassign": ["warn"],
    "class-methods-use-this": ["warn"],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-nested-ternary": "off",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "ForInStatement",
        "message": "for..in loops iterate over the entire prototype chain, which is virtually never what you want. Use Object.{keys,values,entries}, and iterate over the resulting array."
      },
      {
        "selector": "LabeledStatement",
        "message": "Labels are a form of GOTO; using them makes code confusing and hard to maintain and understand."
      },
      {
        "selector": "WithStatement",
        "message": "`with` is disallowed in strict mode because it makes code impossible to predict and optimize."
      },
      {
        "selector": "CallExpression[callee.property.name='replace'][arguments.0.type='Literal'][arguments.0.value=/\\n/]",
        "message": "String#replace() with a plain string argument only replaces the first match; a literal containing a newline is almost always meant to replace every occurrence (code-scanning alert #2, js/incomplete-sanitization). Use replaceAll(), or a RegExp with the /g flag, instead."
      },
      {
        "selector": "NewExpression[callee.object.name='Handlebars'][callee.property.name='SafeString'] CallExpression[callee.property.name='text']",
        "message": "Wrapping text extracted from a DOM node's .text() in Handlebars.SafeString marks it safe to insert as raw, unescaped HTML wherever it's rendered, even though .text() can smuggle HTML-decoded markup back in (code-scanning alert #3, js/xss-through-dom). Return the plain string and let Handlebars escape it normally."
      }
    ],
    "import/extensions": ["warn", "always"]
  },
  "globals": {
    "$": "readonly",
    "ActiveEffect": "readonly",
    "Actor": "readonly",
    "Babele": "readonly",
    "CONFIG": "readonly",
    "CONST": "readonly",
    "CSS": "readonly",
    "ChatMessage": "readonly",
    "Combat": "readonly",
    "Combatant": "readonly",
    "ContextMenu": "readonly",
    "Dialog": "readonly",
    "Folder": "readonly",
    "FormApplication": "readonly",
    "FormDataExtended": "readonly",
    "Handlebars": "readonly",
    "Hooks": "readonly",
    "ImagePopout": "readonly",
    "Item": "readonly",
    "Macro": "readonly",
    "Roll": "readonly",
    "Scene": "readonly",
    "TokenDocument": "readonly",
    "canvas": "readonly",
    "debugger": "readonly",
    "document": "readonly",
    "duplicate": "readonly",
    "foundry": "readonly",
    "fromUuid": "readonly",
    "fromUuidSync": "readonly",
    "game": "readonly",
    "getProperty": "readonly",
    "globals": "readonly",
    "hasProperty": "readonly",
    "isNewerVersion": "readonly",
    "mergeObject": "readonly",
    "parseUuid": "readonly",
    "randomID": "readonly",
    "saveDataToFile": "readonly",
    "setProperty": "readonly",
    "ui": "readonly",
    "window": "readonly",
    "getComputedStyle": "readonly",
    "globalThis": "readonly",
    "HTMLElement": "readonly",
    "Node": "readonly"
  },
  "settings": {
    "import/extensions": [".js"]
  },
  "overrides": [
    {
      "files": ["gulp/**/*.mjs", "gulpfile.mjs"],
      "rules": {
        "func-names": "off",
        "no-param-reassign": "off"
      }
    },
    {
      "files": ["src/modules/system/migrate/scripts/**/*.js"],
      "rules": {
        "class-methods-use-this": "off"
      }
    }
  ]
}
